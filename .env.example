# Porta do servidor (padrão 3000)
PORT=3000

# MySQL
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Assinatura dos tokens de sessão (mínimo de 32 caracteres, aleatório). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Cifra das credenciais dos bancos em ban_credenciais (AES-256-GCM, 32 bytes em base64).
# Tem de ser IGUAL no local e na Vercel (o banco é o mesmo); perdê-la obriga a
# digitar as credenciais de novo. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHAVE_CREDENCIAIS=
